FROM node:24-alpine AS web-build

WORKDIR /opt/applylens/apps/web
COPY apps/web/package*.json ./
RUN npm ci
COPY apps/web ./
ARG VITE_API_URL=
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

FROM python:3.12-slim

WORKDIR /opt/applylens/apps/api
COPY apps/api/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY apps/api/app ./app
COPY apps/api/migrations ./migrations
COPY --from=web-build /opt/applylens/apps/web/dist /opt/applylens/apps/web/dist

ENV WEB_STATIC_DIR=/opt/applylens/apps/web/dist

EXPOSE 10000

CMD ["sh", "-c", "python -m app.migrations && exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-10000}"]
