# Copy this file to a secure location outside Git and replace every placeholder.
POSTGRES_DB=applylens
POSTGRES_USER=applylens
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://applylens:replace-with-url-encoded-password@postgres:5432/applylens

WEB_ORIGIN=https://app.example.com
PUBLIC_API_URL=https://api.example.com
BIND_ADDRESS=127.0.0.1
API_PORT=8000
WEB_PORT=8080
LOG_LEVEL=INFO
# Set this to the trusted reverse proxy address or CIDR seen by the API container.
FORWARDED_ALLOW_IPS=127.0.0.1

# Account recovery email. Keep SMTP_PASSWORD only in the secure deployment file.
EMAIL_DELIVERY=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=support@example.com
SMTP_STARTTLS=true

# Keep deterministic lexical retrieval unless OpenAI + pgvector are intentionally enabled.
RETRIEVAL_PROVIDER=lexical
RETRIEVAL_STORAGE=memory
OPENAI_API_KEY=
