# Copy this file to a secure location outside Git and replace every placeholder.
# STAGING_WEB_HOST and STAGING_API_HOST are hostnames only, without https://.
# They must share one registrable parent domain so the SameSite=Lax session
# cookie works between the frontend and API (for example, two example.com hosts).
STAGING_WEB_HOST=staging.example.com
STAGING_API_HOST=api.staging.example.com
TLS_EMAIL=operations@example.com

# These URLs must match the two hostnames above.
WEB_ORIGIN=https://staging.example.com
PUBLIC_API_URL=https://api.staging.example.com

POSTGRES_DB=applylens
POSTGRES_USER=applylens
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://applylens:replace-with-url-encoded-password@postgres:5432/applylens

# The API and web debug ports stay reachable only from the deployment host.
BIND_ADDRESS=127.0.0.1
API_PORT=8000
WEB_PORT=8080
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
LOG_LEVEL=INFO

# Caddy is the only public API proxy in this staging topology. The API port
# remains bound to 127.0.0.1, so forwarded headers may be trusted here.
FORWARDED_ALLOW_IPS=*

# Per-client or per-account abuse controls. Values apply within the shared window.
RATE_LIMIT_WINDOW_SECONDS=60
REGISTRATION_RATE_LIMIT=5
PASSWORD_RESET_RATE_LIMIT=5
DOCUMENT_UPLOAD_RATE_LIMIT=10
OPPORTUNITY_INGEST_RATE_LIMIT=20
OPPORTUNITY_ANALYSIS_RATE_LIMIT=30
FREE_BETA_DOCUMENT_LIMIT=25
FREE_BETA_OPPORTUNITY_LIMIT=50
FREE_BETA_REVIEW_LIMIT=100
FREE_BETA_TASK_LIMIT=200
PRODUCT_VERSION=0.1.0-beta.1
RELEASE_CHANNEL=free-public-beta
SUPPORT_EMAIL=support@example.com
INCIDENT_CONTACT_EMAIL=incident-response@example.com

# Account recovery requires a real STARTTLS-capable mailbox in staging.
EMAIL_DELIVERY=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=support@example.com
SMTP_STARTTLS=true

# Start with deterministic retrieval. Enable OpenAI + pgvector separately only
# after the base staging deployment and backup/restore checks pass.
RETRIEVAL_PROVIDER=lexical
RETRIEVAL_STORAGE=memory
OPENAI_API_KEY=
